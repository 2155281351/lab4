n11:e -> c15:p11:w [color="black", label=""];
n11:e -> c16:p11:w [color="black", label=""];
n11:e -> c17:p11:w [color="black", label=""];
c16:p12:e -> n12:w [color="black", label=""];
c15:p2:e -> n2:w [color="black", label=""];
n2:e -> c13:p2:w [color="black", label=""];
n3:e -> c15:p3:w [color="black", label=""];
c13:p4:e -> n4:w [color="black", style="setlinewidth(3)", label=""];
n4:e -> c17:p4:w [color="black", style="setlinewidth(3)", label=""];
c17:p5:e -> n5:w [color="black", style="setlinewidth(3)", label=""];
