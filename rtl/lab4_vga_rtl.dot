c17 [ shape=record, label="{{<p4> pic_state|<p6> pix_x|<p7> pix_y|<p10> sys_rst_n|<p11> vga_clk}|vga_pic_inst\nvga_pic|{<p5> pix_data}}" ];
c16:p1:e -> n1:w [color="black", label=""];
n10:e -> c13:p10:w [color="black", label=""];
