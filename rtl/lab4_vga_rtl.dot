digraph "lab4_vga" {
label="lab4_vga";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="hsync", color="black", fontcolor="black" ];
n2 [ shape=diamond, label="key_flag", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="key_in", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="pic_state", color="black", fontcolor="black" ];
n5 [ shape=diamond, label="pix_data", color="black", fontcolor="black" ];
n6 [ shape=diamond, label="pix_x", color="black", fontcolor="black" ];
n7 [ shape=diamond, label="pix_y", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="rgb", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="sys_clk", color="black", fontcolor="black" ];
n10 [ shape=octagon, label="sys_rst_n", color="black", fontcolor="black" ];
n11 [ shape=diamond, label="vga_clk", color="black", fontcolor="black" ];
n12 [ shape=octagon, label="vsync", color="black", fontcolor="black" ];
c13 [ shape=record, label="{{<p2> key_flag|<p10> sys_rst_n|<p11> vga_clk}|fsm_inst\nfsm|{<p4> pic_state}}" ];
